{
  "manifest_version": 3,
  "name": "GitHub 本地加速",
  "version": "1.0.0",
  "description": "将 GitHub 代码与下载流量转发到本机 HTTP 代理。",
  "minimum_chrome_version": "110",
  "permissions": ["proxy", "storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "GitHub 本地加速",
    "default_popup": "popup/popup.html"
  }
}